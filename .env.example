# =============================================================================
# 環境變數範本
#
# 使用方式：複製成 .env 後，只填你會用到的項目
#   cp .env.example .env
#
# - .env 已在 .gitignore，不會被 commit；API Key 也不會存進資料庫或匯出檔
# - 系統環境變數的優先順序高於 .env
# - 用不到的項目留空即可。只評測自己啟動的本地 API（vLLM、TEI…）時，通常什麼都不用填
# - API Key 修改後立即生效；Hugging Face 與「本系統設定」區塊修改後請重新啟動 embedbench
# =============================================================================


# ---- 雲端 Embedding / Reranker API Key ---------------------------------------
# Web UI「API Key 環境變數名稱」欄位要填的，就是等號左邊的名稱

# OpenAI：text-embedding-3-small / large；LLM 排序（RankGPT）也使用這個
OPENAI_API_KEY=

# Cohere：embed-v4.0、rerank-v3.5
COHERE_API_KEY=

# Voyage AI：voyage-3.5、voyage-multilingual-2、voyage-multimodal-3、rerank-1
VOYAGE_API_KEY=

# Google Gemini API：gemini-embedding-001
GEMINI_API_KEY=

# Mistral：mistral-embed
MISTRAL_API_KEY=

# Jina AI：jina-reranker-v2-base-multilingual
JINA_API_KEY=


# ---- Google Vertex AI：text-multilingual-embedding-002 -----------------------
GCP_PROJECT_ID=

# 以 gcloud auth print-access-token 取得，約 1 小時後失效。
# 留空時，系統會自動執行 gcloud auth print-access-token（需要先 gcloud auth login）
GCP_ACCESS_TOKEN=


# ---- 自己啟動的 API 服務（選填）---------------------------------------------
# 若 vLLM / TEI 等服務啟動時設定了 --api-key，把同一組金鑰填在這裡，
# 再到 Web UI「API Key 環境變數名稱」填 LOCAL_API_KEY。名稱可以自訂，例如多台服務各用一個名稱
LOCAL_API_KEY=


# ---- Hugging Face（選填）-----------------------------------------------------
# 本地載入需要授權的模型時使用：例如 google/embeddinggemma-2，需先在模型頁同意授權。
# 只用 API 評測時不需要；下載 TCEval / C-MTEB 等公開資料集時也可以不填
HF_TOKEN=

# 使用鏡像站時設定，例如 https://hf-mirror.com
# HF_ENDPOINT=

# 模型與資料集的下載快取位置（預設 ~/.cache/huggingface）
# HF_HOME=


# ---- 本系統設定（選填）------------------------------------------------------
# 執行期資料（資料庫、資料集、向量快取、評測結果）的存放位置；相對路徑以專案根目錄為準
# EMBEDBENCH_DATA_DIR=data

# 內建預設檔（embedding.yaml、reranker.yaml）所在的資料夾
# EMBEDBENCH_PRESETS_DIR=presets
